{
  "name": "electron-trident",
  "productName": "Trident",
  "version": "0.5.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "description": "Multi-Model AI Collaborative Workspace",
  "author": "Dave Sebek",
  "license": "AGPL-3.0-only",
  "homepage": "https://tridenthq.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eastechs/trident.git"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "notices": "node scripts/generate-notices.js",
    "predev": "npm run notices",
    "prebuild": "npm run notices",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:main\" \"npm run dev:electron\"",
    "dev:vite": "vite --config vite.config.ts",
    "dev:main": "tsup --watch",
    "dev:electron": "node scripts/wait-for-vite.js && node scripts/launch-electron.js",
    "start": "node scripts/launch-electron.js",
    "build": "tsup && node scripts/check-runtime-dependencies.js && vite build --config vite.config.ts",
    "build:all": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "test:image-providers": "node scripts/verify-image-provider-contracts.mjs",
    "test:provider-contracts": "node --import tsx --test src/main/ai/provider-contracts.test.ts",
    "test:desktop-contracts": "node --import tsx --test src/main/desktop-contracts.test.ts scripts/runtime-dependencies.test.js",
    "format": "prettier --write src/ scripts/ vite.config.ts tsup.config.ts",
    "format:check": "prettier --check src/ scripts/ vite.config.ts tsup.config.ts",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "types:check": "tsc --noEmit",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "4.0.97",
    "@ai-sdk/anthropic": "^3.0.72",
    "@ai-sdk/azure": "3.0.55",
    "@ai-sdk/google": "^3.0.65",
    "@ai-sdk/google-vertex": "4.0.113",
    "@ai-sdk/openai": "^3.0.54",
    "@ai-sdk/react": "^3.0.171",
    "@aws-sdk/credential-providers": "3.1106.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electric-sql/pglite": "^0.2.0",
    "@fontsource-variable/figtree": "^5.2.10",
    "@headlessui/react": "^2.2.9",
    "@milkdown/crepe": "^7.19.0",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@rive-app/react-webgl2": "^4.27.1",
    "@streamdown/cjk": "^1.0.2",
    "@streamdown/code": "^1.1.0",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/typography": "^0.5.19",
    "@xyflow/react": "^12.10.1",
    "ai": "^6.0.169",
    "aws4fetch": "1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "driver.js": "^1.4.0",
    "drizzle-orm": "^0.45.2",
    "electron-context-menu": "5.0.0",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.3",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.1.0",
    "google-auth-library": "10.9.1",
    "ignore": "5.3.2",
    "lucide-react": "^0.577.0",
    "media-chrome": "^4.18.0",
    "motion": "^12.36.0",
    "nanoid": "^5.1.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-jsx-parser": "^2.4.1",
    "react-resizable-panels": "^4.9.0",
    "react-router-dom": "^7.14.1",
    "react-spinners": "^0.17.0",
    "shiki": "^4.0.2",
    "streamdown": "^2.4.0",
    "tailwind-merge": "^3.5.0",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.0.1",
    "drizzle-kit": "^0.31.10",
    "electron": "44.2.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "shadcn": "4.2.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.5.1",
    "tsx": "4.21.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.23.0",
    "vite": "^7.0.4"
  },
  "overrides": {
    "axios": "1.14.0"
  }
}
